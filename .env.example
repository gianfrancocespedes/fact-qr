# ---------------------------------------------------------------------------
# Autenticación (JWT)
# ---------------------------------------------------------------------------

# Secreto de firma HS256. DEBE ser idéntico en ambas APIs: la qr-api emite y
# propaga el token, y la stats-api lo valida con el mismo secreto.
#
# Es obligatoria: ninguna de las dos APIs tiene valor por defecto y ambas abortan el
# arranque si falta. El valor de abajo sirve para levantar el entorno local; en
# producción se configura uno aleatorio en el panel de Railway, nunca en el repositorio:
#
#   openssl rand -base64 32
JWT_SECRET=solo-para-desarrollo-local

# Vigencia del token emitido. Formato de duración de Go (ej. 30m, 1h, 24h).
JWT_EXPIRATION=1h

# ---------------------------------------------------------------------------
# qr-api (Go + Fiber)
# ---------------------------------------------------------------------------

QR_API_PORT=8080

# URL base de la stats-api vista *desde* la qr-api.
STATS_API_URL=http://localhost:3000

# Timeout del cliente HTTP hacia la stats-api.
STATS_API_TIMEOUT=60s

# ---------------------------------------------------------------------------
# stats-api (Node + Express)
# ---------------------------------------------------------------------------

STATS_API_PORT=3000

# Tolerancia para comparar contra cero al verificar si una matriz es diagonal.
# QR produce valores irracionales, así que un cero real llega como 1e-17 y una
# comparación exacta (=== 0) daría falsos negativos.
DIAGONAL_EPSILON=1e-9

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Orígenes permitidos, separados por coma.
# Ambas APIs lo necesitan: la stats-api también recibe peticiones directas del
# navegador (botón de estadísticas), no solo llamadas servidor-a-servidor desde Go.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# web (React + Vite)
# ---------------------------------------------------------------------------

# Vite solo expone al cliente las variables con prefijo VITE_.
VITE_QR_API_URL=http://localhost:8080
VITE_STATS_API_URL=http://localhost:3000
